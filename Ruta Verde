<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Ruta Verde: app y sitio web para encontrar productores rurales de Uruguay, conocer su origen y contactarlos directo. Proyecto final de egreso 2026.">
<meta name="theme-color" content="#0E401F">
<meta property="og:title" content="Ruta Verde · Conectamos orígenes, elegimos futuro">
<meta property="og:description" content="Encontrá productores, sabores y experiencias rurales de Uruguay. Proyecto final de egreso 2026.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%B1%3C/text%3E%3C/svg%3E">
<title>Ruta Verde · Conectamos orígenes, elegimos futuro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Sora:wght@500;700;800&family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  /* colores tomados del logo */
  --leaf:#659A31;--forest:#0E401F;--leaf-l:#E7F1D8;--leaf-ll:#F3F8EC;
  --bg:#F6F9F1;--surface:#FFFFFF;--ink:#13261A;--muted:#52665A;--line:#D3E0C6;--on-dark:#F4F9EC;--sun:#D9A93A;
  --logo:url(data:image/png;base64,);
  --head:"Sora","Trebuchet MS",system-ui,sans-serif;
  --body:"Atkinson Hyperlegible","Segoe UI",system-ui,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --leaf:#8FC656;--forest:#9BD5A0;--leaf-l:#1C2D17;--leaf-ll:#16241A;
    --bg:#0D1710;--surface:#15231A;--ink:#E5F0E4;--muted:#9DB4A2;--line:#27402B;--sun:#E5B94F;
  }
}
:root[data-theme="dark"]{
  --leaf:#8FC656;--forest:#9BD5A0;--leaf-l:#1C2D17;--leaf-ll:#16241A;
  --bg:#0D1710;--surface:#15231A;--ink:#E5F0E4;--muted:#9DB4A2;--line:#27402B;--sun:#E5B94F;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:18px;line-height:1.6}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--surface);border-bottom:1px solid var(--line)}
header.top .wrap{display:flex;gap:6px;align-items:center;padding-top:8px;padding-bottom:8px;overflow-x:auto}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--forest);font-family:var(--head);font-weight:800;margin-right:10px;white-space:nowrap}
.lg{background:var(--logo) center/cover no-repeat;border-radius:50%;display:block;flex:none}
.brand .lg{width:44px;height:44px}
.flogo{width:56px;height:56px;margin-bottom:10px}
header.top a.l{color:var(--ink);text-decoration:none;font-size:.93rem;padding:7px 12px;border-radius:999px;white-space:nowrap}
header.top a.l:hover{background:var(--leaf-l)}
.btn{display:inline-block;font:inherit;font-weight:700;text-decoration:none;border:0;cursor:pointer;padding:12px 24px;border-radius:12px;background:var(--leaf);color:#0A2410;white-space:nowrap}
.btn.dark{background:var(--forest);color:var(--on-dark)}
:root[data-theme="dark"] .btn.dark,:root:not([data-theme="light"]) .btn.dark{}
header.top .btn{margin-left:auto;padding:9px 18px}
.hero{background:linear-gradient(160deg,var(--leaf-ll),var(--leaf-l));border-bottom:1px solid var(--line);padding:56px 0 48px}
.hero .grid{display:grid;grid-template-columns:1.2fr 1fr;gap:34px;align-items:center}
.eyebrow{font-weight:700;color:var(--leaf);letter-spacing:.08em;text-transform:uppercase;font-size:.85rem}
.hero h1{font-family:var(--head);font-weight:800;font-size:clamp(2.4rem,7.5vw,4.4rem);line-height:1;letter-spacing:-.03em;margin:8px 0 14px;color:var(--forest)}
.hero h1 em{font-style:normal;color:var(--leaf)}
.hero p.s{font-size:1.18rem;color:var(--muted);max-width:42ch;margin:0 0 20px}
.hero .logo{width:100%;max-width:300px;aspect-ratio:1/1;justify-self:center;box-shadow:0 10px 40px rgba(14,64,31,.18)}
.search{display:flex;gap:8px;max-width:520px}
.search input{flex:1;min-width:0;font:inherit;border:2px solid var(--line);background:var(--surface);color:var(--ink);border-radius:12px;padding:12px 14px}
section{padding:60px 0}
section.alt{background:var(--surface);border-block:1px solid var(--line)}
h2{font-family:var(--head);font-weight:800;font-size:clamp(1.7rem,5vw,2.5rem);line-height:1.08;letter-spacing:-.02em;margin:0 0 10px;color:var(--forest)}
.sub{color:var(--muted);max-width:62ch;margin:0 0 26px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
.chip{font:inherit;font-size:.95rem;border:2px solid var(--leaf);background:var(--surface);color:var(--ink);padding:6px 16px;border-radius:999px;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--forest);border-color:var(--forest);color:var(--on-dark)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px}
section.alt .card{background:var(--bg)}
.prod .tag{display:inline-block;font-size:.78rem;font-weight:700;color:var(--forest);background:var(--leaf-l);border-radius:6px;padding:1px 9px;margin-bottom:8px}
.prod h3{font-family:var(--head);margin:0 0 2px;font-size:1.1rem}
.prod .m{color:var(--muted);font-size:.92rem}
.prod .pr{margin-top:8px;font-weight:700;color:var(--forest)}
.num{font-family:var(--head);font-weight:800;font-size:2.2rem;color:var(--leaf);line-height:1}
.step b,.card h3{font-family:var(--head)}
.step p,.card p{margin:4px 0 0;color:var(--muted);font-size:.97rem}
.demo{font-size:.88rem;color:var(--muted);margin-top:14px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.seal{border-left:6px solid var(--leaf)}
.seal.v{border-left-color:var(--forest)}
.seal ul{margin:8px 0 0;padding-left:20px}.seal li{margin:5px 0}
.bars{display:grid;gap:12px;margin-top:16px}
.bar .t{display:flex;justify-content:space-between;gap:10px;font-size:.95rem;margin-bottom:3px}
.bar .t b{color:var(--forest);font-family:var(--head)}
.track{height:12px;background:var(--line);border-radius:6px;overflow:hidden}
.fill{height:100%;background:var(--leaf);border-radius:6px}
.wrapx{overflow-x:auto}
table.plans{width:100%;border-collapse:collapse;background:var(--surface);border:1px solid var(--line);min-width:560px}
.plans th,.plans td{padding:12px 14px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.plans thead th{font-family:var(--head)}
.plans thead th.hi{background:var(--forest);color:var(--on-dark)}
.plans .price{font-family:var(--head);font-weight:800;font-size:1.5rem;display:block}
.plans .price small{font-size:.85rem;font-weight:400}
.plans tbody th{font-weight:700;color:var(--muted);width:24%}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
details{background:var(--surface);border:1px solid var(--line);border-radius:14px;margin:0 0 10px;padding:0 18px}
section.alt details{background:var(--bg)}
summary{cursor:pointer;font-family:var(--head);font-weight:700;padding:15px 0;list-style:none;color:var(--forest);display:flex;justify-content:space-between;gap:12px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-size:1.4rem;line-height:1;color:var(--leaf)}
details[open] summary::after{content:"–"}
details p{margin:0 0 16px;color:var(--ink)}
.team{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.person b{font-family:var(--head);display:block;color:var(--forest)}
.person span{color:var(--muted);font-size:.95rem}
footer{background:var(--forest);color:var(--on-dark);padding:30px 0 50px;font-size:.92rem}
:root:not([data-theme="light"]) footer{}
footer p{margin:0 0 10px;opacity:.93;max-width:75ch}
@media (max-width:760px){.hero .grid,.two{grid-template-columns:1fr}.hero .logo{max-width:210px;order:-1}}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}

/* ---- funciones interactivas ---- */
:root{--warnbg:#FBE9D2;--warnink:#7A3F08}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--warnbg:#3A2A12;--warnink:#F3C98A}}
:root[data-theme="dark"]{--warnbg:#3A2A12;--warnink:#F3C98A}
.speak{display:none;margin-top:10px;font:inherit;font-size:.88rem;border:2px solid var(--leaf);background:transparent;color:var(--forest);border-radius:999px;padding:4px 14px;cursor:pointer}
.js .speak{display:inline-block}
.speak[aria-pressed="true"]{background:var(--leaf);color:#0A2410}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:22px}
section.alt .panel{background:var(--bg)}
.panel h3{font-family:var(--head);color:var(--forest);margin:0 0 6px}
.status{display:inline-block;font-weight:700;border-radius:999px;padding:3px 14px;background:var(--leaf-l);color:var(--forest);margin-bottom:10px}
.status.off{background:var(--warnbg);color:var(--warnink)}
.switch{display:flex;gap:10px;align-items:center;font-weight:700;margin:6px 0 14px}
.switch input{width:22px;height:22px;accent-color:var(--leaf)}
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;align-items:end;margin-bottom:12px}
label.f{display:grid;gap:4px;font-size:.9rem;font-weight:700}
label.f input,label.f select{font:inherit;font-weight:400;border:2px solid var(--line);background:var(--bg);color:var(--ink);border-radius:10px;padding:9px 11px;width:100%}
section.alt label.f input,section.alt label.f select{background:var(--surface)}
.items{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.items li{display:flex;justify-content:space-between;gap:10px;align-items:center;border:1px solid var(--line);border-radius:12px;padding:10px 14px;background:var(--bg)}
section.alt .items li{background:var(--surface)}
.pill{font-size:.8rem;font-weight:700;border-radius:999px;padding:2px 12px;white-space:nowrap}
.pill.p{background:var(--warnbg);color:var(--warnink)}
.pill.s{background:var(--leaf-l);color:var(--forest)}
.pill.g{background:var(--leaf);color:#0A2410}
.res{margin-top:14px;border-radius:14px;padding:16px 18px;border:2px solid var(--line);background:var(--bg)}
section.alt .res{background:var(--surface)}
.res.ok{border-color:var(--forest)}
.res.pr{border-color:var(--leaf)}
.res.no{border-color:#C0472F}
.res b.big{font-family:var(--head);font-size:1.25rem;color:var(--forest);display:block}
.mini{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0}
.mini button{font:inherit;font-size:.88rem;border:2px solid var(--leaf);background:transparent;color:var(--forest);border-radius:999px;padding:4px 12px;cursor:pointer}
.tiles{display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:repeat(7,1fr);gap:6px;max-width:440px;width:100%}
.tile{aspect-ratio:1/1;font:inherit;font-size:.66rem;font-weight:700;line-height:1.1;border:2px solid transparent;border-radius:10px;padding:2px;cursor:pointer;display:grid;place-items:center;text-align:center;word-break:break-word}
.tile.f1{background:var(--forest);color:var(--on-dark)}
.tile.f2{background:var(--leaf);color:#0A2410}
.tile.f3{background:var(--leaf-l);color:var(--ink);border-color:var(--leaf)}
.tile[aria-pressed="true"]{outline:3px solid var(--sun);outline-offset:2px}
.legend{display:flex;flex-wrap:wrap;gap:12px;margin:0 0 14px;font-size:.92rem}
.legend i{display:inline-block;width:14px;height:14px;border-radius:4px;vertical-align:-2px;margin-right:6px}
.mapwrap{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:24px;align-items:start}
.js-only{display:none}.js .js-only{display:block}
.nojs-note{font-size:.9rem;color:var(--muted)}.js .nojs-note{display:none}
@media (max-width:760px){.mapwrap{grid-template-columns:1fr}}

/* ---- estilo editorial (inspirado en la maqueta de Lovable) ---- */
:root{--serif:"Instrument Serif","Georgia",serif;--cream:#FBF8EE;--olive:#E9E8D2}
:root{--bg:#FBF8EE;--leaf-ll:#F4F2E4}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--cream:#12190F;--olive:#1B2616;--bg:#12190F}}
:root[data-theme="dark"]{--cream:#12190F;--olive:#1B2616;--bg:#12190F}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 112px)}
body h1,body h2,body h3{font-family:var(--serif);font-weight:400;letter-spacing:-.01em}
body h2{font-size:clamp(2rem,6vw,3.1rem);line-height:1.04}
.eb{font-family:var(--head);font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--leaf)}
header.top .hd{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;padding-top:8px;padding-bottom:8px;overflow:visible}
.brand{gap:10px}
.brand .bt{display:grid;line-height:1.05}
.brand .bt b{font-family:var(--serif);font-weight:400;font-size:1.35rem;color:var(--forest)}
.brand .bt small{font-family:var(--head);font-size:.55rem;letter-spacing:.14em;text-transform:uppercase;color:var(--leaf);font-weight:700}
.mn{display:flex;gap:6px;justify-content:center}
.mn a{font-family:var(--head);font-size:.8rem;font-weight:700;color:var(--ink);text-decoration:none;padding:6px 12px;border-bottom:2px solid transparent}
.mn a:hover,.mn a.on{color:var(--leaf);border-color:var(--leaf)}
.btn.out{background:transparent;border:1.5px solid var(--line);color:var(--ink);font-family:var(--head);font-size:.8rem;justify-self:end;padding:8px 16px;border-radius:8px}
.sub2{border-top:1px solid var(--line);background:var(--bg)}
.sub2 .wrap{display:flex;gap:2px;overflow-x:auto;padding-top:2px;padding-bottom:2px}
.sub2 a{font-size:.82rem;color:var(--muted);text-decoration:none;padding:6px 11px;border-radius:999px;white-space:nowrap}
.sub2 a:hover{background:var(--leaf-l);color:var(--forest)}
header.top .wrap{display:block;padding-top:0;padding-bottom:0}
header.top .hd{display:grid}
.hero2{margin:22px auto 0;max-width:1040px;padding:0 20px}
.hero2 .box{position:relative;border-radius:18px;overflow:hidden;min-height:340px;display:flex;align-items:center;background:#27421F}
.hero2 svg.bgart{position:absolute;inset:0;width:100%;height:100%}
.hero2 .shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,32,14,.86) 0%,rgba(10,32,14,.55) 48%,rgba(10,32,14,0) 78%)}
.hero2 .in{position:relative;padding:44px 40px;max-width:560px;color:#fff}
.hero2 .tg{display:flex;align-items:center;gap:10px;font-family:var(--head);font-size:.68rem;letter-spacing:.16em;font-weight:700;text-transform:uppercase;color:#D8E9B8}
.hero2 .tg::before{content:"";width:28px;height:2px;background:#D8E9B8}
.hero2 h1{font-size:clamp(2.8rem,9vw,4.8rem);line-height:.95;margin:12px 0 12px;color:#fff}
.hero2 h1 em{font-style:italic}
.hero2 p{margin:0 0 20px;color:#E4F0D2;max-width:40ch}
.hero2 .search{background:#fff;border-radius:10px;padding:6px;max-width:480px}
.hero2 .search input{border:0;background:transparent;color:#1B2A1A;padding:10px 12px}
.hero2 .search input:focus-visible{outline:none}
.hero2 .search .btn{background:var(--forest);color:#fff;padding:10px 20px;border-radius:8px}
.sec-h{display:flex;justify-content:space-between;align-items:end;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.sec-h h2{margin:2px 0 0}
.chips .chip{border-radius:8px;border:1.5px solid var(--line);background:var(--surface);font-family:var(--head);font-size:.78rem;font-weight:700;padding:8px 14px}
.chips .chip[aria-pressed="true"]{background:var(--forest);border-color:var(--forest);color:#fff}
.btn.sm{padding:8px 16px;border-radius:8px;font-family:var(--head);font-size:.78rem;background:transparent;border:1.5px solid var(--line);color:var(--ink)}
.pc{position:relative;padding:0;overflow:hidden;border-radius:12px;display:flex;flex-direction:column}
.pc .art{display:block;width:100%;aspect-ratio:5/3}
.pc .bd{padding:14px 16px 16px;display:flex;flex-direction:column;flex:1}
.pc .aw{position:relative}
.pc .badge{position:absolute;left:10px;bottom:10px;background:#fff;color:#1B2A1A;font-size:.68rem;font-family:var(--head);font-weight:700;border-radius:5px;padding:2px 8px}
.pc .heart{position:absolute;right:10px;top:10px;width:34px;height:34px;border-radius:8px;border:0;background:#fff;color:#8A9A86;cursor:pointer;font-size:1.05rem;display:grid;place-items:center}
.pc .heart[aria-pressed="true"]{color:var(--forest)}
.pc .tag{background:none;padding:0;margin:0 0 4px;font-family:var(--head);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--leaf);border-radius:0}
.pc h3{font-size:1.45rem;margin:0 0 2px;color:#7A4A12}
.pc .rt{position:absolute;right:16px;margin-top:2px;font-family:var(--head);font-size:.78rem;font-weight:700}
.pc .rt i{color:#D9A93A;font-style:normal}
.pc .pr{font-size:.92rem}
.pc .speak{align-self:flex-start;margin-top:auto}
.empty{border:2px dashed var(--line);border-radius:14px;padding:26px;text-align:center;color:var(--muted)}
.hecho{background:var(--olive);padding:60px 0}
.hecho .two2{display:grid;grid-template-columns:1fr 1.2fr;gap:36px;align-items:center}
.hecho .st{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #B7B88F;border-bottom:1px solid #B7B88F}
.hecho .st div{padding:20px 12px;text-align:center;border-left:1px solid #B7B88F}
.hecho .st div:first-child{border-left:0}
.hecho .st b{font-family:var(--serif);font-weight:400;font-size:2.3rem;display:block;color:var(--forest);line-height:1}
.hecho .st span{font-family:var(--head);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
:root:not([data-theme="light"]) .hecho .st,:root[data-theme="dark"] .hecho .st{}
.mapa{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.3fr);gap:22px;align-items:start}
.ml{display:grid;gap:10px}
.mi{display:grid;grid-template-columns:64px 1fr;gap:12px;text-align:left;font:inherit;color:inherit;background:var(--surface);border:1.5px solid var(--line);border-radius:10px;padding:8px;cursor:pointer;align-items:center}
.mi[aria-pressed="true"]{border-color:var(--forest);background:var(--leaf-l)}
.mi svg{width:64px;height:48px;border-radius:8px;display:block}
.mi b{font-family:var(--serif);font-weight:400;font-size:1.15rem;display:block;color:#7A4A12}
.mi small{color:var(--muted)}
.pmapbox{position:relative;background:var(--olive);border:1px solid var(--line);border-radius:14px;padding:18px}
.ptiles{display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:repeat(7,1fr);gap:5px;max-width:420px;margin:0 auto}
.pt{aspect-ratio:1/1;border-radius:9px;background:rgba(101,154,49,.18);border:0;position:relative;font:inherit;font-size:.6rem;color:var(--muted);display:grid;place-items:end center;padding:2px;line-height:1.05;text-align:center}
.pt.has{background:#C8D7A6;cursor:pointer;color:var(--forest);font-weight:700}
.pt .pin{position:absolute;top:18%;left:50%;transform:translateX(-50%);width:22px;height:22px;border-radius:50%;background:var(--forest);color:#fff;display:grid;place-items:center;font-size:.7rem}
.pt.sel .pin{background:#D9A93A;color:#1B2A1A;transform:translateX(-50%) scale(1.25)}
.pop{margin-top:14px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px;display:flex;gap:12px;align-items:center}
.pop svg{width:64px;height:48px;border-radius:8px;flex:none}
.pop b{font-family:var(--serif);font-weight:400;font-size:1.2rem;color:#7A4A12;display:block}
@media (max-width:760px){
  header.top .hd{grid-template-columns:auto 1fr auto}
  .brand .bt small{display:none}
  .hero2 .in{padding:30px 22px}
  .hecho .two2,.mapa{grid-template-columns:1fr}
}

/* ---- ajustes de contraste (modo oscuro) ---- */
:root{--brown:#7A4A12}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--brown:#E6B67A}}
:root[data-theme="dark"]{--brown:#E6B67A}
