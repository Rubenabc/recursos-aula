<script>
(function(){
  var cards=Array.prototype.slice.call(document.querySelectorAll('#list .card'));
  var chips=document.querySelectorAll('#chips .chip');
  var q=document.getElementById('q'),cat='todo';
  function apply(){
    var t=(q.value||'').toLowerCase().trim();
    cards.forEach(function(c){
      var okc=cat==='todo'||(' '+c.getAttribute('data-c')+' ').indexOf(' '+cat+' ')>-1;
      var okt=!t||c.textContent.toLowerCase().indexOf(t)>-1;
      c.style.display=(okc&&okt)?'':'none';
    });
  }
  Array.prototype.forEach.call(chips,function(b){
    b.addEventListener('click',function(){
      cat=b.getAttribute('data-c');
      Array.prototype.forEach.call(chips,function(x){x.setAttribute('aria-pressed',x===b)});
      apply();
    });
  });
  q.addEventListener('input',apply);
})();

(function(){
  function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}

  /* 1) Lectura en voz alta */
  var synth=window.speechSynthesis;
  var cur=null;
  function textoFicha(card){
    var parts=[];
    ['h3','.m','p','.pr'].forEach(function(sel){var n=card.querySelector(sel);if(n)parts.push(n.textContent.trim())});
    return parts.join('. ').replace(/\$(\d[\d.]*)/g,'$1 pesos').replace(/\s+/g,' ');
  }
  Array.prototype.forEach.call(document.querySelectorAll('.speak'),function(b){
    b.addEventListener('click',function(){
      if(!synth||!window.SpeechSynthesisUtterance){b.textContent='🔇 No disponible en este navegador';return}
      if(cur===b){synth.cancel();return}
      synth.cancel();
      var u=new SpeechSynthesisUtterance(textoFicha(b.closest('.card')));
      u.lang='es-AR';u.rate=.95;
      function fin(){b.setAttribute('aria-pressed','false');b.textContent='🔊 Escuchar';if(cur===b)cur=null}
      u.onend=fin;u.onerror=fin;
      cur=b;b.setAttribute('aria-pressed','true');b.textContent='⏹ Detener';
      synth.speak(u);
    });
  });

  /* 2) Demo sin conexión */
  var sw=document.getElementById('off-sw'),st=document.getElementById('off-status'),lst=document.getElementById('off-list'),msg=document.getElementById('off-msg');
  var items=[],timer=null;
  function renderOff(){
    lst.textContent='';
    items.forEach(function(it){
      var li=el('li');
      li.appendChild(el('span','',it.n+' · $'+it.p+' por kilo · '+it.s+' kg'));
      var lab=it.st==='pend'?['p','Pendiente de sincronizar']:it.st==='sync'?['s','Sincronizando…']:['g','Publicado en el mapa'];
      li.appendChild(el('span','pill '+lab[0],lab[1]));
      lst.appendChild(li);
    });
  }
  function cuenta(s){return items.filter(function(i){return i.st===s}).length}
  sw.addEventListener('change',function(){
    if(timer){clearTimeout(timer);timer=null}
    if(sw.checked){
      st.textContent='● Sin conexión';st.className='status off';
      msg.textContent='Sin señal: lo que cargues queda guardado cifrado en el celular.';
    }else{
      st.textContent='● Con conexión';st.className='status';
      var n=cuenta('pend');
      items.forEach(function(i){if(i.st==='pend')i.st='sync'});
      renderOff();
      if(n){
        msg.textContent='Volvió la señal: se envían '+n+(n===1?' producto':' productos')+' a la nube.';
        timer=setTimeout(function(){
          items.forEach(function(i){if(i.st==='sync')i.st='pub'});
          renderOff();
          msg.textContent='Listo: '+(n===1?'el producto ya está publicado':'los '+n+' productos ya están publicados')+' en el mapa, sin que el productor haga nada.';
        },1400);
      }else{msg.textContent='Con conexión, lo que cargues se publica enseguida.'}
    }
  });
  document.getElementById('off-add').addEventListener('click',function(){
    var n=document.getElementById('off-n').value.trim();
    if(!n){msg.textContent='Escribí el nombre del producto.';return}
    var p=parseFloat(document.getElementById('off-p').value),s=parseFloat(document.getElementById('off-s').value);
    items.push({n:n,p:isNaN(p)?0:p,s:isNaN(s)?0:s,st:sw.checked?'pend':'pub'});
    document.getElementById('off-n').value='';document.getElementById('off-p').value='';document.getElementById('off-s').value='';
    renderOff();
    msg.textContent=sw.checked?'Guardado en el celular. Se publicará cuando haya conexión ('+cuenta('pend')+' pendiente'+(cuenta('pend')===1?'':'s')+').':'Publicado en el mapa.';
  });

  /* 3) Verificador de sello */
  var SEL={
    'RV-0001':{t:'v',n:'Finca Agroecológica El Ceibo (ejemplo)',p:86,d:[['Manejo ambiental',27,30],['Bienestar animal e inocuidad',22,25],['Identidad territorial',22,25],['Origen y escala',15,20]],x:'Re-auditoría anual obligatoria dentro de 10 meses.'},
    'RV-0002':{t:'p',n:'Taller Lana (ejemplo)',x:'Vigencia de 60 días corridos desde la validación de la Declaración Jurada Digital. Quedan 24 días. Con el Plan Premium puede solicitar la auditoría presencial para el sello Verificado.'},
    'RV-0003':{t:'s',n:'Productor de ejemplo',x:'Sello suspendido temporalmente tras una denuncia fundamentada. Tiene 30 días para corregir las observaciones antes de una eventual revocación.'}
  };
  var vres=document.getElementById('v-res'),vin=document.getElementById('v-code');
  function verificar(c){
    var k=(c||'').toUpperCase().replace(/\s+/g,'');
    if(/^RV\d{4}$/.test(k))k='RV-'+k.slice(2);
    vres.textContent='';
    var d=SEL[k],box;
    if(!d){
      box=el('div','res no');box.appendChild(el('b','big','Código no encontrado'));
      box.appendChild(el('span','','Revisá el código del sello. Si no coincide con ninguno registrado, no lo tomes como válido.'));
      vres.appendChild(box);return;
    }
    if(d.t==='v'){
      box=el('div','res ok');box.appendChild(el('b','big','Sello Verde Verificado'));
      box.appendChild(el('span','',d.n+' · puntaje '+d.p+' sobre 100 (mínimo 80)'));
      d.d.forEach(function(r){
        var wrap=el('div','bar');wrap.style.marginTop='10px';
        var t=el('div','t');t.appendChild(el('span','',r[0]));t.appendChild(el('b','',r[1]+' / '+r[2]));wrap.appendChild(t);
        var tr=el('div','track'),f=el('div','fill');f.style.width=(r[1]/r[2]*100)+'%';tr.appendChild(f);wrap.appendChild(tr);box.appendChild(wrap);
      });
      box.appendChild(el('p','demo',d.x));
    }else{
      box=el('div','res '+(d.t==='p'?'pr':'no'));
      box.appendChild(el('b','big',d.t==='p'?'Sello Verde Provisional':'Sello suspendido'));
      box.appendChild(el('span','',d.n));box.appendChild(el('p','demo',d.x));
    }
    vres.appendChild(box);
  }
  document.getElementById('v-go').addEventListener('click',function(){verificar(vin.value)});
  vin.addEventListener('keydown',function(e){if(e.key==='Enter')verificar(vin.value)});
  Array.prototype.forEach.call(document.querySelectorAll('#v-ex button'),function(b){b.addEventListener('click',function(){vin.value=b.getAttribute('data-v');verificar(vin.value)})});

  /* 4) Mapa de despliegue por fases */
  var FASE={
    '1':['Meses 1 a 4','Lanzamiento piloto en el eje metropolitano, hortifrutícola, quesero y turístico. Captación presencial en cooperativas, sociedades de fomento y ferias. Auditoría inicial de 30 a 40 fincas para el Sello Verde.'],
    '2':['Meses 5 a 8','Expansión a la cuenca lechera, los corredores turísticos, las sierras y el litoral agroindustrial y citrícola. Pauta digital geolocalizada y convenios con intendencias y centros turísticos.'],
    '3':['Meses 9 a 12','Integración nacional completa. Incorporación digital masiva de productores mediante acuerdos con el MGAP, el MINTUR (Uruguay Natural) y las intendencias, y presencia en eventos como la Expo Prado y la Semana de la Cerveza.']
  };
  var tiles=document.querySelectorAll('.tile');
  Array.prototype.forEach.call(tiles,function(t){
    t.addEventListener('click',function(){
      Array.prototype.forEach.call(tiles,function(x){x.setAttribute('aria-pressed',x===t)});
      var f=t.getAttribute('data-f');
      document.getElementById('d-t').textContent=t.getAttribute('data-d')+': Fase '+f;
      document.getElementById('d-s').textContent=FASE[f][0];
      document.getElementById('d-p').textContent=FASE[f][1]+' La app y la web ya funcionan en este departamento desde el primer día.';
    });
  });

  /* 5) Recomendador de plan */
  document.getElementById('r-go').addEventListener('click',function(){
    var prod=+document.getElementById('r-prod').value,rut=+document.getElementById('r-rut').value,sel=+document.getElementById('r-sel').value,wa=+document.getElementById('r-wa').value;
    var plan,precio,anual,razones=[];
    if(rut||sel||prod===3){
      plan='Premium';precio='$800 por mes';anual='o $7.800 por año (18,75 % menos)';
      if(prod===3)razones.push('Tenés más de 20 productos: el catálogo ilimitado es del Plan Premium.');
      if(rut)razones.push('Las rutas turísticas sugeridas son del Plan Premium.');
      if(sel)razones.push('El Sello Verde Verificado, con auditoría en finca, es exclusivo del Plan Premium.');
    }else if(prod===2||wa){
      plan='Estándar';precio='$400 por mes';anual='o $4.000 por año (16,7 % menos)';
      if(prod===2)razones.push('Entre 6 y 20 productos entran en el catálogo del Plan Estándar (hasta 20).');
      if(wa)razones.push('Incluye enlace a WhatsApp y botón de llamada directa.');
    }else{
      plan='Gratuito';precio='$0 por mes';anual='sin costo';
      razones.push('Hasta 5 productos y una ficha con tus datos de contacto alcanzan para empezar.');
      razones.push('Recibís el Sello Verde Provisional al firmar la Declaración Jurada Digital.');
    }
    var o=document.getElementById('r-out');o.textContent='';
    var box=el('div','res ok');box.appendChild(el('b','big','Plan '+plan));
    box.appendChild(el('span','',precio+' · '+anual));
    var ul=el('ul');ul.style.margin='8px 0 0';ul.style.paddingLeft='20px';
    razones.forEach(function(r){ul.appendChild(el('li','',r))});box.appendChild(ul);
    box.appendChild(el('p','demo','Al registrarte, probás el Plan Premium 30 días sin costo.'));
    o.appendChild(box);
  });
})();



(function(){
  function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
  var list=document.getElementById('list');
  var cards=Array.prototype.slice.call(list.querySelectorAll('.pc'));
  var saved=[];
  try{saved=JSON.parse(localStorage.getItem('rv-guardados')||'[]')||[]}catch(e){saved=[]}
  function persist(){try{localStorage.setItem('rv-guardados',JSON.stringify(saved))}catch(e){}}
  function toggle(id){var i=saved.indexOf(id);if(i>-1)saved.splice(i,1);else saved.push(id);persist();paint()}
  function paint(){
    cards.forEach(function(c){c.querySelector('.heart').setAttribute('aria-pressed',saved.indexOf(c.getAttribute('data-id'))>-1)});
    var g=document.getElementById('glist');g.textContent='';
    cards.forEach(function(c){
      if(saved.indexOf(c.getAttribute('data-id'))>-1){
        var k=c.cloneNode(true);var sp=k.querySelector('.speak');if(sp)sp.remove();
        k.style.display='';var h=k.querySelector('.heart');h.setAttribute('aria-pressed','true');
        h.addEventListener('click',function(){toggle(c.getAttribute('data-id'))});
        g.appendChild(k);
      }
    });
    document.getElementById('gempty').style.display=saved.length?'none':'block';
    document.getElementById('gcount').textContent=saved.length?'('+saved.length+')':'';
  }
  cards.forEach(function(c){c.querySelector('.heart').addEventListener('click',function(){toggle(c.getAttribute('data-id'))})});
  paint();

  /* mapa de productores */
  var PR={ceibo:['Finca Agroecológica El Ceibo','Colonia','Miel y verduras','4,9'],aromos:['Granja Tradicional «Los Aromos»','San José','Quesos y experiencias','4,8'],quesos:['Finca Quesos','Canelones','Quesos','4,7'],posada:['Posada','Colonia','Alojamiento','4,9'],lana:['Taller Lana','San José','Artesanías','4,8']};
  var POS={Artigas:[1,0],Salto:[0,1],Rivera:[3,1],'Paysandú':[0,2],'Tacuarembó':[2,2],'Cerro Largo':[4,2],'Río Negro':[0,3],Durazno:[2,3],'Treinta y Tres':[4,3],Soriano:[0,4],Flores:[1,4],Florida:[2,4],Lavalleja:[3,4],Rocha:[4,4],Colonia:[0,5],'San José':[1,5],Canelones:[2,5],Maldonado:[3,5],Montevideo:[2,6]};
  var cur='ceibo';
  var tilesBox=document.getElementById('ptiles'),mlist=document.getElementById('mlist'),pop=document.getElementById('pop');
  function porDepto(d){return Object.keys(PR).filter(function(k){return PR[k][1]===d})}
  function artDe(id){var c=cards.filter(function(x){return x.getAttribute('data-id')===id})[0];var a=c&&c.querySelector('svg.art');return a?a.cloneNode(true):el('span')}
  function pintaMapa(){
    tilesBox.textContent='';
    Object.keys(POS).forEach(function(d){
      var ids=porDepto(d),t=el('button','pt'+(ids.length?' has':'')+(ids.indexOf(cur)>-1?' sel':''));
      t.type='button';t.style.gridColumn=POS[d][0]+1;t.style.gridRow=POS[d][1]+1;t.textContent=d;
      if(ids.length){var p=el('span','pin',ids.length>1?String(ids.length):'●');t.appendChild(p);t.addEventListener('click',function(){cur=ids.indexOf(cur)>-1&&ids.length>1?ids[(ids.indexOf(cur)+1)%ids.length]:ids[0];pintaMapa()})}
      else{t.disabled=true}
      tilesBox.appendChild(t);
    });
    mlist.textContent='';
    Object.keys(PR).forEach(function(id){
      var b=el('button','mi');b.type='button';b.setAttribute('aria-pressed',id===cur);
      var a=artDe(id);a.removeAttribute('class');b.appendChild(a);
      var d=el('div');d.appendChild(el('b','',PR[id][0]));d.appendChild(el('small','',PR[id][2]+' · '+PR[id][1]));b.appendChild(d);
      b.addEventListener('click',function(){cur=id;pintaMapa()});mlist.appendChild(b);
    });
    pop.textContent='';
    var a2=artDe(cur);a2.removeAttribute('class');pop.appendChild(a2);
    var dd=el('div');dd.appendChild(el('b','',PR[cur][0]));dd.appendChild(el('small','',PR[cur][1]+' · ★ '+PR[cur][3]));pop.appendChild(dd);
  }
  pintaMapa();
})();



(function(){
  var b=document.getElementById('faqtog');if(!b)return;
  var all=function(){return document.querySelectorAll('#preguntas details')};
  function estado(){var abiertas=0;Array.prototype.forEach.call(all(),function(d){if(d.open)abiertas++});b.textContent=abiertas?'Cerrar todas':'Abrir todas'}
  b.addEventListener('click',function(){
    var abrir=b.textContent==='Abrir todas';
    Array.prototype.forEach.call(all(),function(d){d.open=abrir});estado();
  });
  Array.prototype.forEach.call(all(),function(d){d.addEventListener('toggle',estado)});
  estado();
})();

</script>
</body>
</html>
